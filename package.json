{
  "name": "@jumboly/jev-client",
  "version": "0.1.0",
  "private": true,
  "description": "TypeSafe AI Jev (typesafe-ai/jev) client for Vercel AI Gateway: shared cooldown, adaptive rate limit, timeout, usage/cost, mock/replay/fallback evaluators",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    }
  },
  "bin": {
    "jev-probe": "./dist/probe.js",
    "jev-proxy": "./dist/proxy-cli.js"
  },
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "probe": "tsx src/probe.ts",
    "proxy": "tsx src/proxy-cli.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
